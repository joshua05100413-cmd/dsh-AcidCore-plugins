{
  "name": "dsh-acid-core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Acid Core: crystal startup animation, six palettes, local image and looping video backgrounds with theme veils and lettering.",
  "scripts": {
    "test": "node validate.mjs && node test-background.mjs && node test-theme-lifecycle.mjs && node test-intro.mjs",
    "test:browser": "node test-wallpaper-browser.mjs",
    "test:video-browser": "node test-video-background-browser.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT"
}
